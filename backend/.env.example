DATABASE_URL=sqlite:///./test.db
OPENAI_API_KEY=xx
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
UPSTASH_BLOB_TOKEN=xx
ENVIRONMENT=development  # Use "production" for the production environment

# Signs login tokens. If unset the app falls back to a publicly known default, so ALWAYS set a
# long random value outside local development (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-to-a-long-random-string

# Chat history (Upstash Redis) and document search (Upstash Vector) - both required.
UPSTASH_REDIS_REST_URL=https://xx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xx
UPSTASH_VECTOR_REST_URL=https://xx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=xx

# Password reset emails. Leave SMTP_HOST unset in development and the reset link
# is printed in the backend log instead of being emailed.
# Base URL of the frontend (the dev server runs on port 3000).
FRONTEND_URL=http://localhost:3000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=xx
# SMTP_PASSWORD=xx
# SMTP_FROM=DocuQuery <no-reply@yourdomain.com>
